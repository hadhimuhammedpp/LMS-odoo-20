<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enrollment_menu" model="ir.actions.act_window">
        <field name="name">enrollments list</field>
        <field name="res_model">lms.enrollment</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!--               list view-->
    <record id="enrollments_list_view" model="ir.ui.view">
        <field name="name">list_view</field>
        <field name="model">lms.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="course_id"/>
                <field name="batch_id"/>
                <field name="state"/>
                <field name="student_id"/>
            </list>
        </field>
    </record>

    <!--    form view-->
    <record id="enrollments_form_view" model="ir.ui.view">
        <field name="name">form_view</field>
        <field name="model">lms.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="confirm_button" type="object" string="Confirm" class="btn-primary"
                            invisible="state in ['confirm','cancel','done']"/>
                    <button name="cancel_button" type="object" string="Cancel" invisible="state in ['cancel','done','confirm']"/>
                    <button name="done_button" class="oe_highlight" type="object" string="Done" invisible="state in ['done','draft','cancel']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Done" bg_color="bg-success" invisible="state in ['draft','confirm','cancel']"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state in ['done','confirm','draft']"/>
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </group>
                    <field name="image" widget="contact_image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="refference_id" context="{'flag':True}"/>
                            <field name="student_id" placeholder="Enter a Student" />
                            <field name="course_id" placeholder="Select the Course"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="course_fee" widget="monetary"/>
                            <field name="dob"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="due_date"/>
                            <field name="is_lead"/>
                            <field name="company_id"/>
                            <field name="batch_id" placeholder="choose the batch"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Scholarships">
                                <field name="scholarship_ids"/>
                        </page>
                        <page string="Terms and conditions">
                            <field name="terms_and_conditions"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!--    search view-->
    <record id="enrollment_search_view" model="ir.ui.view">
        <field name="name">search view</field>
        <field name="model">lms.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="course_id"/>
                <filter name="for customer 1" domain="[('student_id','=','customer 1')]"/>
                <filter name="for mern stack" domain="[('course_id','=','mern stack')]"/>
                <filter name="group_by" context="{'group_by':'batch_id','residual_visible':'True'}"/>
                <filter name="group_by" context="{'group_by':'course_id','residual_visible':'True'}"/>
            </search>
        </field>
    </record>
</odoo>


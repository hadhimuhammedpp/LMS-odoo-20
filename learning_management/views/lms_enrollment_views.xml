<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="enrollment_menu" model="ir.actions.act_window">
        <field name="name">enrollments list</field>
        <field name="res_model">lms.enrollment</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!--               list view-->
    <record id="enrollments_list_view" model="ir.ui.view">
        <field name="name">list_view</field>
        <field name="model">lms.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="course_id"/>
                <field name="course_fee"/>
                <field name="state"/>
                <field name="student_id"/>
            </list>
        </field>
    </record>

    <!--    form view-->
    <record id="enrollments_form_view" model="ir.ui.view">
        <field name="name">form_view</field>
        <field name="model">lms.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="course_id"/>
                            <field name="course_fee"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="due_date"/>
                            <field name="is_lead"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Terms and conditions">

                            <field name="terms_and_conditions"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
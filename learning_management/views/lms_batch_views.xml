<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="batch_menu" model="ir.actions.act_window">
        <field name="name">batch list</field>
        <field name="res_model">lms.batch</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_archived':True}</field>
    </record>

    <record id="batch_list_view" model="ir.ui.view">
        <field name="name">list_view</field>
        <field name="model">lms.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="batch_name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="batch_form_view" model="ir.ui.view">
        <field name="name">form_view</field>
        <field name="model">lms.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                        <button name="run_billing_button" type="object" string="Run Billing" class="btn-primary" invisible="state == 'completed'"/>
                        <button name="reset_to_draft_button" type="object" string="Reset to Draft" invisible="state == 'ongoing'"/>
<!--                        <field name="state" widget="statusbar"/>-->
                </header>
                <sheet>
                    <div name="button_box" groups="base.group_user">
                        <button name='students_enrolled' type="object" class="oe_stat_button" icon="person">
                            <field name='student_count' widget='statinfo'/>
                        </button>
                        <button name='invoices_button' type="object" class="oe_stat_button" icon="payments" string="Invoices">

                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="batch_name"/>
                            <field name="capacity"/>
                            <field name="course_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                                    <field name="enrollment_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scholarships">
                            <field name="scholarship_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
     <!--    search view-->
    <record id="batch_search_view" model="ir.ui.view">
        <field name="name">search view</field>
        <field name="model">lms.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="batch_name"/>
                <field name="enrollment_ids"/>
                <filter name="archived" domain="[('active','=','False')]"/>
                <filter name="group_by" context="{'group_by':'state','residual_visible':'True'}"/>
            </search>
        </field>
    </record>
</odoo>
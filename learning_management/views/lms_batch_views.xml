<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="batch_menu" model="ir.actions.act_window">
        <field name="name">batch list</field>
        <field name="res_model">lms.batch</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="batch_list_view" model="ir.ui.view">
        <field name="name">list_view</field>
        <field name="model">lms.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="batch_name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="batch_form_view" model="ir.ui.view">
        <field name="name">form_view</field>
        <field name="model">lms.batch</field>
        <field name="arch" type="xml">
            <form>
<!--                <header>-->
<!--                    <button name="start_button" type="object" class="oe_highlight" string="Start"-->
<!--                            invisible="state=='cancelled'"/>-->
<!--                    <button name="complete_button" type="object" string="Complete" invisible="state=='cancelled'"/>-->
<!--                    <button name="cancel_button" type="object" string="Cancel" invisible="state=='cancelled'"/>-->
<!--                    <field name="state" widget="statusbar" statusbar_visible="draft,ongoing,completed"/>-->
<!--                </header>-->
                <sheet>
                    <div name="button_box" groups="base.group_user">
                        <button name='students_enrolled' type="object" class="oe_stat_button" icon="person">
                            <field name='student_count' widget='statinfo'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="batch_name"/>
                            <field name="capacity"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="course_id"/>
                            <field name="enrollment_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scholarships">
                            <field name="scholarship_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
     <!--    search view-->
    <record id="batch_search_view" model="ir.ui.view">
        <field name="name">search view</field>
        <field name="model">lms.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="batch_name"/>
                <field name="enrollment_ids"/>
                <filter name="for python course" domain="[('course_id','=','python full stack')]"/>
                <filter name="group_by" context="{'group_by':'state','residual_visible':'True'}"/>
            </search>
        </field>
    </record>
</odoo>
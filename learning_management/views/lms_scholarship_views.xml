<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="scholarship_menu" model="ir.actions.act_window">
        <field name="name">scholarship list</field>
        <field name="res_model">lms.scholarship</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="scholarship_list_view" model="ir.ui.view">
        <field name="name">list_view</field>
        <field name="model">lms.scholarship</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="discount_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="scholarship_form_view" model="ir.ui.view">
        <field name="name">form_view</field>
        <field name="model">lms.scholarship</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name='approve_button' type="object" class="oe_highlight" invisible="state in ['pending','fully approved','confirmed','rejected']" string="Approve"/>
                    <button name="first_approve_button" type="object" invisible="state in ['pending','rejected','first approved','fully approved']" string="First Approve"/>
                    <button name="confirm_button" type="object" invisible="state in ['rejected','first approved','fully approved','confirmed']" string="Confirm"/>
                    <button name="reject_button" type="object" invisible="state in ['rejected','fully approved']" string="Reject"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,confirmed,first approved, fully approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Fully Approved" bg_color="bg-success" invisible="state in ['pending','first approved','confirmed','rejected']"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="bg-danger" invisible="state in ['pending','confirmed','first approved','fully approved']"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="enrollment_id" options="{'no_create':True}"/>
                            <field name="student_id"/>
                            <field name="course_id"/>
                        </group>
                        <group>
                            <field name="validity"/>
                            <field name="due_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="discount_amount"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

        <!--    search view-->
    <record id="scholarship_search_view" model="ir.ui.view">
        <field name="name">search view</field>
        <field name="model">lms.scholarship</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="enrollment_id"/>
                <filter name="for customer 1" domain="[('student_id','=','customer 1')]"/>
                <filter name="for govt scholarship" domain="[('name','=','govt scholarship')]"/>
                <filter name="group_by" context="{'group_by':'name','residual_visible':'True'}"/>
            </search>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="scholarship_menu" model="ir.actions.act_window">
        <field name="name">scholarship list</field>
        <field name="res_model">lms.scholarship</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="scholarship_list_view" model="ir.ui.view">
        <field name="name">list_view</field>
        <field name="model">lms.scholarship</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="enrollment_id"/>
                <field name="state"/>
                <field name="student_id"/>
                <field name="validity"/>
                <field name="discount_amount"/>
            </list>
        </field>
    </record>


    <record id="scholarship_form_view" model="ir.ui.view">
        <field name="name">form_view</field>
        <field name="model">lms.scholarship</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name='approve_button' type="object" class="oe_highlight" invisible="state in ['fully approved','rejected']" string="Approve"/>
                    <button name="reject_button" type="object" invisible="state=='rejected'" string="Reject"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,confirmed,first approved, fully approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="enrollment_id" options="{'no_create':True}"/>
                            <field name="student_id"/>
                            <field name="course_id"/>
                        </group>
                        <group>
                            <field name="validity"/>
                            <field name="due_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="discount_amount"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="scholarship_menu" model="ir.actions.act_window">
        <field name="name">scholarship list</field>
        <field name="res_model">lms.scholarship</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="scholarship_list_view" model="ir.ui.view">
        <field name="name">list_view</field>
        <field name="model">lms.scholarship</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="enrollment_id"/>
                <field name="state"/>
                <field name="student_id"/>
                <field name="validity"/>
                <field name="discount_amount"/>
            </list>
        </field>
    </record>


    <record id="scholarship_form_view" model="ir.ui.view">
        <field name="name">form_view</field>
        <field name="model">lms.scholarship</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name='sellbuttonaction' type="object" invisible="status == 'Sold'" string="sell"/>

                    <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="enrollment_id"/>

                        <field name="student_id"/>
                        <field name="validity"/>
                        <field name="discount_amount"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
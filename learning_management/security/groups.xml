<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lms" model="ir.module.category">
       <field name="name">lms</field>
       <field name="description">Helps you manage My Module access rights</field>
       <field name="sequence">25</field>
   </record>
    <record id="res_groups_privilege_lms" model="res.groups.privilege">
        <field name="name">LMS</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_category_lms"/>
    </record>
    <record id="group_lms_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_lms"/>
        <field name="comment">the user will have limited access to the LMS.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_lms_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="comment">the user will have all access to the LMS.</field>
        <field name="privilege_id" ref="res_groups_privilege_lms"/>
        <field name="implied_ids" eval="[(4, ref('group_lms_user'))]"/>
<!--        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>-->
    </record>
</odoo>

